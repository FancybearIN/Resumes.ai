{
  "manifest_version": 3,
  "name": "Resumes.ai",
  "version": "1.0.1",
  "description": "Simple AI-powered resume tailoring assistant for cybersecurity jobs.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
